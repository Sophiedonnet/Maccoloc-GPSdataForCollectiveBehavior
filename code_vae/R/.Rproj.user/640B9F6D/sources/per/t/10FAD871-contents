create_Ztrim <- function(bestfit){
  nTrim <- length(bestfit$A)
  nNavires <- 33
  Ztrim <- sapply(seq(nTrim), function(x) {
    y <- rep(NA, nNavires)
    y[(seq(nNavires) %in% names(bestfit$Z[[x]]))] <- bestfit$Z[[x]]
    return(y)
  })
  Z_trim_map <- (outer(Z_trim, seq(bestfit$Q), "==") |> 
                   apply(c(1,3), "mean", na.rm = TRUE)) |> 
    apply(1, "which.max")
  return(list(Z_trim = Z_trim, Z_trim_map = Z_trim_map))
}


