estim <- 'nous'
#estim <- 'nousQ5'

if(estim=='saintclair'){
  iidcolsbm_trim <- readRDS("./Rdata/save_sbmfit/iidcolsbm_trim.rds")
}else{
  iidcolsbm_trim <- readRDS("./Rdata/save_sbmfit/iidcolsbm_trim_round8.rds")
  if(estim =='nous'){
    iidcolsbm_trim <- iidcolsbm_trim$best_fit
    }else{
    iidcolsbm_trim <- iidcolsbm_trim$model_list[[1]][[5]][[1]] 
    }
}
Q <-iidcolsbm_trim$nb_clusters



                                      
                                      
                                      





#===============================================================================
# Export the matrices from the colSBM
#===============================================================================
trim_matrices <- lapply(
  seq(20),
  function(l) {
    A <- matrix(NA, 33, 33)
    A[trim_peche[[l]], trim_peche[[l]]] <- matrix(iidcolsbm_trim$A[[l]])
    A[A==-1] <- NA
    diag(A) <- NA
    return(A)
  }
)


#===============================================================================
# Compute the map of memberships for each vessel
#===============================================================================
Z_trim <- sapply(seq(20), function(x) {
  y <- rep(NA, 33)
  y[(seq(33) %in% names(iidcolsbm_trim$Z[[x]]))] <- iidcolsbm_trim$Z[[x]]
  return(y)
})
if (estim=='nous'){
  Z_trim_relabel =  Z_trim
  map_sc <- c(`1`= 4, `2`=2, `3`=1, `4`=5, `5`=3, `6`=6)
  for(t in 1:20){
    Z_trim_relabel[,t] <- map_sc[as.character(Z_trim[,t])]
    }
  map_ls <- c(`1`=5, `2`=4, `3`=3, `4`=2, `5`=1, `6`=6)
  Z_trim_nolabelsw <- Z_trim_relabel
  for(t in 1:20){
    if(Z_trim_relabel[1,t]==2){ #on affecte bateau 1 au block 1 donc on echange label 2 3 pour 1 4
      Z_trim_nolabelsw[,t] <- map_ls[as.character(Z_trim_relabel[,t])]
  }
}
}
Z_trim <- Z_trim_nolabelsw






#------------- relabelling comme Saint Clair


if(estim=='saintclair'){ord_plot_blocks = 1:Q}
if(estim=='nous'){ord_plot_blocks = order(map_sc[1:Q])}




