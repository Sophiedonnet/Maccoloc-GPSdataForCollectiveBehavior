df_xgv_capt <- read_csv("Rdata/sacrois_xgv_capt.csv")
df_cvae <- read_csv(file = "./Rdata/xgv_cvae_3_reordered_filtered.csv")
trim_peche <- readRDS("./Rdata/trim_peche.rds")
df_traj <- read_csv("Rdata/xgv_100_14-18.csv")
df_traj <- df_traj %>% filter(wday(time) %in% c(2,3,4,5,6)) |>
  filter(maree != 12097796)


estim <- 'saintclair'
estim <- 'nous'
#estim <- 'nousQ5'

if(estim=='saintclair'){
  iidcolsbm_trim <- readRDS("./Rdata/save_sbmfit/iidcolsbm_trim.rds")
}else{
  iidcolsbm_trim <- readRDS("./Rdata/save_sbmfit/iidcolsbm_trim_round8.rds")
  if(estim =='nous'){
    iidcolsbm_trim <- iidcolsbm_trim$best_fit
  }else{
    iidcolsbm_trim <- iidcolsbm_trim$model_list[[1]][[5]][[1]] 
  }
}
Q <-iidcolsbm_trim$nb_clusters


Z_trim <- sapply(seq(20), function(x) {
  y <- rep(NA, 33)
  y[(seq(33) %in% names(iidcolsbm_trim$Z[[x]]))] <- iidcolsbm_trim$Z[[x]]
  return(y)
})
if (estim=='nous'){
  Z_trim_relabel =  Z_trim
  map_sc <- c(`1`= 4, `2`=2, `3`=1, `4`=5, `5`=3, `6`=6)
  for(t in 1:20){
    Z_trim_relabel[,t] <- map_sc[as.character(Z_trim[,t])]
  }
  map_ls <- c(`1`=5, `2`=4, `3`=3, `4`=2, `5`=1, `6`=6)
  Z_trim_nolabelsw <- Z_trim_relabel
  for(t in 1:20){
    if(Z_trim_relabel[1,t]==2){ #on affecte bateau 1 au block 1 donc on echange label 2 3 pour 1 4
      Z_trim_nolabelsw[,t] <- map_ls[as.character(Z_trim_relabel[,t])]
    }
  }
  Z_trim <- Z_trim_nolabelsw
}


navire_id <- df_cvae |> pull(navire) |> unique()

df_cvae_group <- df_cvae %>% 
  mutate(quarteryear = quarter(time) + 4*(year(time) - 2014)) %>% 
  mutate(navire = factor(navire, levels = navire_id)) %>% 
  group_by(maree) %>% 
  mutate(Group = Z_trim[navire, quarteryear])


df_xgv_capt %>% 
  #  mutate(MONTANT_EUROS_MOYENNE = pmin(MONTANT_EUROS_MOYENNE, 8000)) %>% 
  filter(MONTANT_EUROS_MOYENNE <= 10000) %>% 
  rename(maree = MAREE_ID) %>% 
  left_join(df_cvae_group) %>%
  
  mutate(quarter = factor(quarter(time)),
         Group = LETTERS[Group]) %>% 
  mutate(date = as_date(paste(year(time), 3*quarter(time),"01", sep = "-"))) %>% 
  group_by(maree, Group, quarter, date) %>% 
  summarise(MONTANT = sum(MONTANT_EUROS_MOYENNE, na.rm = TRUE)) %>%
  ggplot(aes(y = MONTANT, x = date, fill = Group, col = Group)) +
  #  geom_smooth() +
  #       stat_ecdf(linewidth = 1.1) +
  stat_flquantiles(probs=c(0.10, 0.90), geom = "ribbon",
                   alpha=0.30) +
  stat_flquantiles(probs=c(0.01), geom = "line",
                   linetype=3) +
  stat_flquantiles(probs=c(0.99), geom = "line",
                   linetype=3) +
  stat_flquantiles(probs=c(0.25, 0.75), geom = "ribbon",
                   alpha=0.30) +
  stat_flquantiles(probs=c(0.50), geom = "line", size=1.5) +
  stat_flquantiles(probs=c(0.50), geom = "line", col = "black") +
  #    geom_boxplot(position = "dodge") +
  ylim(c(0, 5000)) + 
  xlab("Date") +
  ylab("Income per trip (Euros)") +
  facet_wrap(~ Group, ncol = Q) +
  theme_bw(base_size = 20) #+


