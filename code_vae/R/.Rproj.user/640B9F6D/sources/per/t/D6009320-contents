#===============================================================================
# This script analyze the trajectories, latent space and income of the fleet per
# group (last part and plot of the manuscript).
# It does the following thing:
# - Import fitted colSBM model
# - Import latent space of cvae3
# - Plot the 20 quarterly proximity graphs
# - Plot mesoscale structure and groups
# - Concatenate group and latent position
# - Compute DSI and GSI for individual
# - Plot DSI and GSI for individual
#===============================================================================

library(tidyverse)
library(lubridate)
library(ggplotFL)
library(patchwork)
