                              linewidth = .5,
                              data = (bc_seuil_navire%>%  
                                        left_join(Mat_navire)) %>% 
                                filter(Model == "c-vae"), 
                              legend_name = "Group") + coord_equal() +
  ggrepel::geom_label_repel(data = bc_seuil_navire%>% 
                              left_join(Mat_navire) %>% 
                              filter(Model == "c-vae") %>% 
                              filter(navire %in% c(2, 6, 19)),
