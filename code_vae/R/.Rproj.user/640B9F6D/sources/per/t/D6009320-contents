  select(x, y, Group, time, maree) %>% 
  mutate(h = rep(seq(24), times = 20511)) %>% 
  mutate(Group = factor(LETTERS[Group], levels = LETTERS[1:5])) %>% 
  na.omit()

write_csv(df_traj_group, "Rdata/sacrois_xgv_capt_group.csv")


